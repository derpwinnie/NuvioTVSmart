# Self-host the VIDAA build so a launcher tile has a stable address to open.
# Build:  docker build -f Dockerfile.vidaa -t nuvio-vidaa .
# Run:    docker run --rm -p 8080:8080 nuvio-vidaa
# Then point a tile at http://<this-host>:8080/?wrapper=vidaa (LAN) or put it
# behind a reverse proxy with https for public access.

FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
# Copy only what the static server needs — not the whole build tree.
COPY --from=build /app/dist ./dist
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/package.json ./package.json
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
# Run as the unprivileged built-in node user.
USER node
CMD ["node", "./scripts/serve.mjs", "--vidaa"]
